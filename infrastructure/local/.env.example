# Copy through `bin/local-server init`; never commit the generated .env.local.
DOMI_LOCAL_PROJECT=domi-local
DOMI_BIND_ADDRESS=127.0.0.1
DOMI_API_PORT=3000
DOMI_APP_HOST=localhost
DOMI_APP_VERSION=local
DOMI_ALLOWED_ORIGINS=
DOMI_DATABASE_PASSWORD=replace-with-a-random-secret
DOMI_SECRET_KEY_BASE=replace-with-a-random-secret
