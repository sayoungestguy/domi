#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_root"

docker compose build api
docker compose up --detach postgres
# The named bundle volume survives image rebuilds, so refresh it whenever the
# lockfile changes instead of allowing it to hide gems installed in the image.
docker compose run --rm api bundle install
docker compose run --rm api bin/rails db:prepare
npm --prefix apps/mobile ci
npm --prefix apps/e2e ci

echo "Domi is ready. Run bin/dev to start the API and mobile app."
