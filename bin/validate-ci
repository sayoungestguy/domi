#!/usr/bin/env ruby
# frozen_string_literal: true

require "yaml"

ROOT = File.expand_path("..", __dir__)

def load_workflow(name)
  path = File.join(ROOT, ".github", "workflows", name)
  abort("Missing workflow: #{path}") unless File.file?(path)

  YAML.safe_load(File.read(path), aliases: true, filename: path)
rescue Psych::SyntaxError => error
  abort("Invalid YAML in #{name}: #{error.message}")
end

def assert(condition, message)
  abort(message) unless condition
end

ci = load_workflow("ci.yml")

assert(ci["name"] == "CI", "ci.yml must retain the required workflow name")
assert(ci.fetch("on").key?("pull_request"), "CI must run for pull requests")
assert(ci.fetch("on").fetch("push").fetch("branches").include?("main"), "CI must run on main")

required_jobs = %w[workflow-validation backend mobile production-build e2e ci-result]
missing_jobs = required_jobs - ci.fetch("jobs").keys
assert(missing_jobs.empty?, "CI is missing required jobs: #{missing_jobs.join(', ')}")

ci_text = File.read(File.join(ROOT, ".github", "workflows", "ci.yml"))
assert(ci_text.include?("npm run e2e"), "CI must execute the Playwright suite")
assert(ci_text.include?("docker/build-push-action@"), "CI must build the production API image")
assert(ci_text.scan("actions/upload-artifact@").length >= 3, "CI must publish test and quality reports")
assert(ci_text.include?("bin/validate-local-host"), "CI must validate the local-host configuration")

publish_path = File.join(ROOT, ".github", "workflows", "publish-api.yml")
assert(!File.exist?(publish_path), "Internet image publication must remain disabled for local hosting")

ci_text.scan(/uses:\s+([^\s]+)/).flatten.each do |action|
  next if action.start_with?("./")

  assert(action.match?(/@v\d+\z/), "Action must use a versioned major tag: #{action}")
end

puts "CI/CD workflows are valid."
