#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_root"

# A forced Docker/Desktop shutdown can leave Puma's bind-mounted PID behind.
# It is generated runtime state and is safe to remove before starting Rails.
rm -f "$project_root/services/api/tmp/pids/server.pid"
docker compose up --detach postgres api
echo "API: http://localhost:3000/api/v1/health"
echo "Starting Expo. Stop it with Ctrl-C; use 'docker compose down' when finished."
npm --prefix apps/mobile start
