{
  "name": "@domi/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "bundle:check": "expo export --platform ios --output-dir dist",
    "check": "npm run test && npm run typecheck && npm run lint && npm run bundle:check",
    "audit": "npm audit --omit=dev --audit-level=critical"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22.13 <25"
  }
}
